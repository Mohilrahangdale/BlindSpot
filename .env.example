# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel: Add this in Project Settings > Environment Variables.
# If omitted or temporarily missing, the application uses resilient built-in cognitive synthesis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional base URL for self-referential links or webhooks.
APP_URL="MY_APP_URL"
